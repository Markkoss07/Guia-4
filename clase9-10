/**
Escribir una funcion que reviba dos numeros enteros y retornar su suma
*/

#include <iostream>
using namespace std;

//Declaracion (encabezado, firma, prototipo)
int sumar (int numero1, int numero2);

//Definicion
/*Esta definicion se la puede colocar en cualquier lugar menos en
el main
*/
int sumar (int numero1, int numero2){
    /*estos parametros se define por valor en caso q alguna letra
    le ponga un numero entero.
    */
    int resultado;
    resultado = numero1 + numero2;
    return resultado;
}

int main () {
int a, b, r;

cout << "Ingrese dos numeros: " << endl;
cin >> a >> b;

r = sumar(a, b);//esto se termina transformando en un entero

cout << "El resultado de la suma es: " << r <<endl;

return 0;
}


