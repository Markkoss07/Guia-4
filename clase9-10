 o "Buenas noches xxxx"
 segun corresponda*/

#include <iostream>

using namespace std;
void saludar (int hora, string nombre); // firma
//void saludar (int &hora, string &nombre)

int main () {
int hora;
string persona;

cout << "Hora: ";
cin >> hora;

cout << "Nombre: ";
cin >> persona;

saludar(hora, persona);
return 0;
}

void saludar (int hora, string nombre){
    //void saludar (int &hora, string &nombre)
    /**Para pasar de un valor a referencia es de la siguiente manera
    hora = 23
    persona = "abel";
    */
    
    
    
    //Si coloco en este void, modifico mis datos como hora y nombre
    //solo afecta en mi funcion pero no en mi main
    if (hora >= 4 && hora <= 12){
        cout << "Buenos dias, ";
    }else if (hora > 12 && hora <= 19){
        cout << "Buenas tardes, ";
    }else {
        cout << "Buenas noches, ";
    }

    cout << nombre << endl;
}

