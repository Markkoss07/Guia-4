int pedirNumeroEntre(int inicio, int fin){
    //como hacemos las validadciones
    int num;

    do{
        num = pedirNumeroEntre();
        if(num < inicio || num > fin){
            cout << "Valor fuera de rango" << endl;
        }
    }while(num < inicio || num > fin);
    return num;
}


